# Supabase project settings (Dashboard -> Settings -> API Keys)
# Get the URL + publishable key from the project "Connect" dialog.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret keys (sb_secret_...) bypass Row Level Security and belong only in
# the backend — never bundle them into the frontend with a VITE_ prefix.
#
# Cloudflare Turnstile site key (Dashboard -> Turnstile -> your widget)
# Leave empty during development to disable the captcha challenge.
VITE_TURNSTILE_SITE_KEY=

# Model host api
VITE_ML_API_URL=http:...
